<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione IIS del sito di produzione.

  La sezione <aspNetCore> viene riscritta da "dotnet publish" (processPath e
  arguments): quello che conta tenere qui e' il resto, che altrimenti andrebbe
  riaggiunto a mano dopo ogni pubblicazione.

  stdoutLogEnabled resta "false": il log su file serve solo per diagnosticare
  un'applicazione che non parte, e va acceso al momento (scrive un file nuovo
  a ogni riavvio).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\GecoApi.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>

  <!-- Rinnovo del certificato HTTPS (win-acme / Let's Encrypt).
       ASP.NET Core intercetta tutte le richieste (path="*"), quindi i file di
       sfida sotto .well-known/acme-challenge non arriverebbero mai a IIS e la
       validazione fallirebbe: qui si ripristina il servizio statico solo per
       quel percorso. Senza questa sezione il certificato non si rinnova. -->
  <location path=".well-known">
    <system.webServer>
      <handlers>
        <clear />
        <add name="AcmeStaticFile" path="*" verb="GET" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <staticContent>
        <clear />
        <mimeMap fileExtension="." mimeType="text/plain" />
        <mimeMap fileExtension=".*" mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
